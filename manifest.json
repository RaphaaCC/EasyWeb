{
  "manifest_version": 3,
  "name": "EasyWeb",
  "description": "Tornando a Web mais democrática e acessível para todos",
  "version": "0.1.0",
  "version_name": "0.1.0-development",
  "action": {
    "default_title": "EasyWeb",
    "default_popup": "popup.html"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles/content.css"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
