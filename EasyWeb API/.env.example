HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=*
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=easyweb
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=easyweb
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
